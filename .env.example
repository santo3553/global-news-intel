# ==========================================
# GLOBAL NEWS INTELLIGENCE - ENVIRONMENT CONFIG
# ==========================================

# Application Environment (development, production, testing)
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database Configuration (PostgreSQL with PostGIS + pgvector)
# For local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/global_news
# For Docker internal: postgresql+asyncpg://postgres:postgres@postgres:5432/global_news
# For local fallback without Docker: sqlite+aiosqlite:///./global_news.db
DATABASE_URL=sqlite+aiosqlite:///./global_news.db
DATABASE_SYNC_URL=sqlite:///./global_news.db

# Redis Configuration
# For local Docker: redis://localhost:6379/0
# For Docker internal: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Local AI & Inference Settings
# Options: local_llm, cpu, mock, ollama, custom
LLM_PROVIDER=mock
LLM_MODEL=mistral-7b-instruct-v0.2.Q4_K_M.gguf
LLM_CONTEXT_SIZE=4096
LLM_TEMPERATURE=0.1

# Embedding Model (Sentence Transformers / GGUF)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Geocoding Service (local_gazetteer, osm, nominatim)
GEOCODING_PROVIDER=local_gazetteer
NOMINATIM_USER_AGENT=global_news_intelligence_local

# News Ingestion Settings
NEWS_FETCH_INTERVAL=900
MAX_ARTICLE_LENGTH=12000
MAX_ARTICLES_PER_FEED=25

# Event Clustering & Deduplication Parameters
CLUSTER_SIMILARITY_THRESHOLD=0.75
DEDUPLICATION_HASH_THRESHOLD=0.92
MAX_CLUSTER_TIME_WINDOW_HOURS=72

# Importance Scoring Weights (Sum to 1.0)
IMPORTANCE_HUMAN_WEIGHT=0.25
IMPORTANCE_GLOBAL_WEIGHT=0.20
IMPORTANCE_GEOGRAPHIC_WEIGHT=0.15
IMPORTANCE_ECONOMIC_WEIGHT=0.10
IMPORTANCE_POLITICAL_WEIGHT=0.10
IMPORTANCE_NOVELTY_WEIGHT=0.10
IMPORTANCE_VELOCITY_WEIGHT=0.05
IMPORTANCE_SOURCE_COVERAGE_WEIGHT=0.05
